# 复制为 .env 后按需修改；docker compose 会自动读取。
# 各占位值在对应阶段启用，见 README 阶段路线。

# ---- 部署（当前阶段生效） ----
WEB_PORT=8088
APP_ENV=production
DB_FILE=journey.db
# TZ=Asia/Shanghai

# ---- 管理员与门禁引导（后端基础阶段生效） ----
# docker compose up 时自动读取：ADMIN_USERNAME/ADMIN_PASSWORD 同填且该用户不存在即自动创建
# 首个管理员；同名已存在则跳过（不重置密码），重置/追加账号仍走 -create-admin CLI。
# 安全提示：配置后会以明文进入容器环境变量（docker inspect 可见），介意可留空改用 CLI 引导。
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 可选：仅在本进程创建管理员时，同时启用站点访问门禁（Argon2id 哈希后写入 site_settings，
# 不会覆盖已设门禁口令）
ADMIN_SITE_PASSWORD=

# ---- 会话 Cookie（当前阶段生效） ----
# 生产 HTTPS 网关就绪后设为 true；本地 http 联调保持 false
COOKIE_SECURE=false

# ---- 腾讯 COS（COS 与后台阶段生效；Bucket 必须私有，密钥只保存在服务端） ----
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
# 预签名 URL 有效期秒数（60–3600，默认 900）
COS_URL_EXPIRES=900
