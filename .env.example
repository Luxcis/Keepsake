# 复制为 .env 后按需修改；docker compose 会自动读取。
# 各占位值在对应阶段启用，见 README 阶段路线。

# ---- 部署（当前阶段生效） ----
WEB_PORT=8088
APP_ENV=production
DB_FILE=journey.db
# 国内网络构建时放开（npm 走 npmmirror、Go 模块走 goproxy.cn）
# BUILD_DOCKERFILE=Dockerfile-cn
# TZ=Asia/Shanghai

# ---- 管理员与门禁引导（后端基础阶段生效） ----
# docker compose up 时自动读取：ADMIN_USERNAME/ADMIN_PASSWORD 同填且该用户不存在即自动创建
# 首个管理员；同名已存在则跳过（不重置密码），重置/追加账号仍走 -create-admin CLI。
# 安全提示：配置后会以明文进入容器环境变量（docker inspect 可见），介意可留空改用 CLI 引导。
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 可选：仅在本进程创建管理员时，同时启用站点访问门禁（Argon2id 哈希后写入 site_settings，
# 不会覆盖已设门禁口令）
ADMIN_SITE_PASSWORD=

# ---- 会话 Cookie（当前阶段生效） ----
# 生产 HTTPS 网关就绪后设为 true；本地 http 联调保持 false
COOKIE_SECURE=false

# ---- Redis（可选；默认不启用） ----
# 启用需两步：下面的注释放开 + profile 方式启动 `docker compose --profile redis up -d`。
# 不启用时会话/限流退化为进程内存（单实例部署可接受；容器重启后管理员会话丢失，需重新登录）。
# REDIS_ADDR=redis:6379
# REDIS_PASSWORD=  # 连接服务器已有 Redis 且开启 requirepass 时填写；compose 内置 redis 无需密码

# ---- 文件存储（开发默认本地磁盘；生产按需选择） ----
# local = 本地磁盘，cos = 腾讯 COS，none = 禁用上传；留空自动选择：
#   COS 四项齐全 → cos；否则 APP_ENV=dev → local；APP_ENV=production → none（503）
# 单机生产也可显式 STORAGE_DRIVER=local（STORAGE_DIR 必须位于持久卷上）。
# STORAGE_DRIVER=local
# 本地存储根目录，默认 {DATA_DIR}/uploads；compose 内即 /data/uploads，无需另配
# STORAGE_DIR=
# 本地签名 URL 有效期秒数（60–3600，默认 900）
# STORAGE_URL_EXPIRES=900
# 签名 HMAC 密钥；留空自动生成并持久化到 {STORAGE_DIR}/.secret，
# 重启后已签发但未过期的 URL 仍然有效
# STORAGE_SECRET=

# ---- 腾讯 COS（COS 与后台阶段生效；Bucket 必须私有，密钥只保存在服务端） ----
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
# 可选：COS 控制台绑定的「自定义源站域名」，如 photos.example.com（可带 https://，不能带路径）。
# 仅用于读取类预签名 URL（原图/缩略图/灯箱）；上传 PUT、HEAD 校验与删除仍走
# {bucket}.cos.{region}.myqcloud.com。读取签名会按该域名计算 Host，
# 因此需已 CNAME 到该桶；CDN 加速域名不适用。
# COS_ORIGIN_DOMAIN=
# 预签名 URL 有效期秒数（60–3600，默认 900）
COS_URL_EXPIRES=900
