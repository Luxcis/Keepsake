# 国内网络构建版：与根级 Dockerfile 保持同步，仅改变 Go/npm 拉取源（不再逐项注释重复语义）。
#   用法一：BUILD_DOCKERFILE=Dockerfile-cn docker compose build
#   用法二：docker build -f Dockerfile-cn -t projectj-app .
# 基础镜像拉取与 apk 源仍在 Docker Hub/alpine 默认源；如需加速请在 docker daemon 配置镜像加速。
# ---------- Stage 1: 前端构建（npmmirror） ----------
FROM node:24-alpine AS web-build
WORKDIR /src
COPY web/package.json web/package-lock.json* ./
RUN npm install --registry=https://registry.npmmirror.com --no-audit --no-fund
COPY web/ .
RUN npm run build

# ---------- Stage 2: 后端构建（goproxy.cn） ----------
FROM golang:1.26-alpine AS go-build
WORKDIR /src
ENV GOPROXY=https://goproxy.cn,direct
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/server ./cmd/server

# ---------- Stage 3: 运行时（与 Dockerfile 相同） ----------
FROM nginx:1.28-alpine
RUN apk add --no-cache ca-certificates tzdata su-exec \
  && adduser -D -H -u 10001 app
COPY --from=web-build /src/dist /usr/share/nginx/html
COPY --from=go-build /out/server /usr/local/bin/server
# 站点配置镜像内自带 else 默认；compose 挂载 deploy/nginx/default.conf（单一事实来源）可覆盖。
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh
EXPOSE 80
# Volume 挂载 /data（SQLite），宿主目录需对 uid 10001 可写（README 提示不变）。
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
